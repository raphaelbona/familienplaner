SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://familienplaner:familienplaner@db:5432/familienplaner
REDIS_URL=redis://redis:6379/0
HOSTING_MODE=self_hosted
CORS_ORIGINS=["http://localhost:5173","http://localhost:8090"]

# Google-Kalender-Import (OAuth-Client vom Typ "Webanwendung", siehe SELF_HOSTING.md).
# GOOGLE_REDIRECT_URI muss exakt dem autorisierten Weiterleitungs-URI entsprechen: https://<api-host>/calendar/sync/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/sync/google/callback
# Öffentliche Frontend-URL: Ziel nach dem Google-Login (<APP_BASE_URL>/kalender); bei https:// wird das State-Cookie "Secure"
APP_BASE_URL=http://localhost:8090
# Zeitzone für ganztägige Google-Termine
APP_TIMEZONE=Europe/Zurich

VISION_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Nur relevant wenn VISION_PROVIDER=ollama (siehe docker-compose.yml, Profil "local-llm")
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_VISION_MODEL=llama3.2-vision
